<%# locals: (item:, total:, color_class:, hide_percentage:, show_border:) %>

<%
  percentage = total.zero? ? 0 : (item[:total].to_f / total * 100).round(1)
  column_count = hide_percentage ? 3 : 4
  category_column_class = hide_percentage ? "col-span-9" : "col-span-7 lg:col-span-8"
  amount_column_class = hide_percentage ? "col-span-3" : "col-span-3 lg:col-span-2"
%>

<tr data-category="category-<%= item[:category_id] %>"
    class="text-secondary text-sm <%= show_border ? "table-divider" : "" %>">
  <td colspan="<%= column_count %>" class="p-0">
    <%= render DS::Disclosure.new(
          variant: :inline,
          class: "w-full",
          summary_class: "list-none cursor-pointer focus-ring",
          summary_aria_label: item[:category_name],
          body_class: nil
        ) do |disclosure| %>
      <% disclosure.with_summary_content do %>
        <div class="grid grid-cols-12 items-center hover:bg-surface-hover transition-colors">
          <div class="<%= category_column_class %> min-w-0 py-3 pl-7 pr-2 lg:pl-9 lg:pr-4">
            <div class="flex items-center gap-2 min-w-0">
              <%= icon "chevron-right", size: "sm", class: "shrink-0 text-subdued group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150" %>

              <% if item[:category_icon] %>
                <div class="h-7 w-7 shrink-0 rounded-full flex justify-center items-center"
                     style="
                       background-color: color-mix(in oklab, <%= item[:category_color] %> 10%, transparent);
                       border-color: color-mix(in oklab, <%= item[:category_color] %> 10%, transparent);
                       color: <%= item[:category_color] %>;
                     ">
                  <%= icon(item[:category_icon], color: "current", size: "sm") %>
                </div>
              <% else %>
                <%= render DS::FilledIcon.new(
                  variant: :text,
                  hex_color: item[:category_color],
                  text: item[:category_name],
                  size: "md",
                  rounded: true
                ) %>
              <% end %>

              <span class="font-medium text-primary truncate"><%= item[:category_name] %></span>
              <span class="text-xs text-subdued whitespace-nowrap">
                (<%= t("reports.transactions_breakdown.table.entries", count: item[:count]) %>)
              </span>
            </div>
          </div>

          <div class="<%= amount_column_class %> py-3 px-2 lg:px-6 text-right whitespace-nowrap">
            <span class="text-sm <%= color_class %> privacy-sensitive">
              <%= Money.new(item[:total], Current.family.currency).format %>
            </span>
          </div>

          <% unless hide_percentage %>
            <div class="col-span-2 py-3 pl-2 pr-4 lg:px-6 text-right whitespace-nowrap">
              <span class="text-sm text-secondary"><%= percentage %>%</span>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="bg-container-inset px-4 py-2 lg:pl-16 lg:pr-6" data-testid="subcategory-entries">
        <% item[:entries].each_with_index do |record, index| %>
          <% entry = record[:entry] %>
          <div class="flex items-center gap-3 py-2 <%= "border-b border-secondary" if index < item[:entries].size - 1 %>"
               data-entry-id="<%= entry.id %>">
            <%= render DS::FilledIcon.new(
              variant: :text,
              text: entry.name,
              size: "sm",
              rounded: true
            ) %>

            <div class="min-w-0 flex-1">
              <%= link_to entry.name,
                    entry_path(entry),
                    class: "block truncate font-medium text-primary hover:underline",
                    data: { turbo_frame: "drawer", turbo_prefetch: false, testid: "report-entry-name" } %>
              <p class="truncate text-xs text-subdued">
                <%= format_date(entry.date) %> · <%= entry.account.name %>
              </p>
            </div>

            <span class="shrink-0 text-sm <%= color_class %> privacy-sensitive">
              <%= Money.new(record[:amount], Current.family.currency).format %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </td>
</tr>
