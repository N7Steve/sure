<%
  percentage = total.zero? ? 0 : (item[:total].to_f / total * 100).round(1)
  is_sub = level == :subcategory
  show_border = local_assigns.fetch(:show_border, false)
  hide_percentage = local_assigns.fetch(:hide_percentage, false)
  row_start_date = local_assigns[:start_date]
  row_end_date = local_assigns[:end_date]
  transfer_row = item[:outflow_account] && item[:inflow_account]
  # /transactions only lists Transaction rows. Skip trade-only buckets (e.g. Other
  # Investments) so the destination is not empty relative to the report row.
  clickable = row_start_date.present? && row_end_date.present? && (transfer_row || item[:has_transactions])
  filter = if transfer_row
    { types: [ "transfer" ], start_date: row_start_date, end_date: row_end_date }
  else
    { categories: [ item[:category_name] ], start_date: row_start_date, end_date: row_end_date }
  end
  transactions_href = clickable ? transactions_path(q: filter, filter_cleared: "1") : nil
%>

<tr data-category="category-<%= item[:category_id] %>"
    class="text-secondary text-sm <%= show_border ? "table-divider" : "" %> <%= clickable ? "relative group/category-row" : "" %>">
  <td colspan="2" class="py-3 px-4 lg:px-6 <%= is_sub ? "pl-7 lg:pl-9" : "" %>">
    <div class="flex items-center gap-2">
      <% if is_sub %>
        <div class="text-subdued">
          <%= icon "corner-down-right" %>
        </div>
      <% end %>
      <% if transfer_row %>
        <div class="flex items-center gap-1.5 text-sm w-full">
           <%= render "accounts/logo", account: item[:outflow_account], size: "sm" %>
           <span class="<%= item[:outflow_account].excluded? ? 'text-subdued' : 'text-primary font-medium' %> truncate">
             <%= item[:outflow_account].name %>
             <% if item[:outflow_account].excluded? %>
               <%= icon "ban", class: "w-3.5 h-3.5 inline ml-0.5 text-subdued mb-0.5", title: t("reports.transactions_breakdown.table.excluded_account") %>
             <% end %>
           </span>
           
           <%= icon "arrow-right", class: "w-3 h-3 text-subdued mx-1 shrink-0" %>
           
           <%= render "accounts/logo", account: item[:inflow_account], size: "sm" %>
           <span class="<%= item[:inflow_account].excluded? ? 'text-subdued' : 'text-primary font-medium' %> truncate">
             <%= item[:inflow_account].name %>
             <% if item[:inflow_account].excluded? %>
               <%= icon "ban", class: "w-3.5 h-3.5 inline ml-0.5 text-subdued mb-0.5", title: t("reports.transactions_breakdown.table.excluded_account") %>
             <% end %>
           </span>
           
          <% if transactions_href %>
            <%= link_to transactions_href, class: "text-xs text-subdued whitespace-nowrap ml-1 hover:text-primary hover:underline transition-colors", data: { turbo_frame: "_top", turbo_prefetch: false } do %>
              (<%= t("reports.transactions_breakdown.table.entries", count: item[:count]) %>)
             <% end %>
           <% else %>
             <span class="text-xs text-subdued whitespace-nowrap ml-1">
               (<%= t("reports.transactions_breakdown.table.entries", count: item[:count]) %>)
             </span>
           <% end %>
        </div>
      <% else %>
        <% if item[:category_icon] %>
          <div class="h-7 w-7 flex-shrink-0 rounded-full flex justify-center items-center <%= clickable ? "group-hover/category-row:scale-105 transition-all duration-300" : "" %>"
            style="
              background-color: color-mix(in oklab, <%= item[:category_color] %> 10%, transparent);
              border-color: color-mix(in oklab, <%= item[:category_color] %> 10%, transparent);
              color: <%= item[:category_color] %>;
            ">
            <%= icon(item[:category_icon], color: "current", size: "sm") %>
          </div>
        <% else %>
          <%= render DS::FilledIcon.new(
            variant: :text,
            hex_color: item[:category_color],
            text: item[:category_name],
            size: "md",
            rounded: true
          ) %>
        <% end %>
        <% if clickable %>
          <%= link_to item[:category_name],
                transactions_href,
                class: "font-medium text-primary hover:underline before:absolute before:inset-0 before:content-['']",
                data: { turbo_frame: "_top", turbo_prefetch: false } %>
        <% else %>
          <span class="font-medium text-primary">
            <%= item[:category_name] %>
          </span>
        <% end %>
        <span class="text-xs text-subdued whitespace-nowrap">
          (<%= t("reports.transactions_breakdown.table.entries", count: item[:count]) %>)
        </span>
      <% end %>
    </div>
  </td>

  <td class="py-3 px-4 lg:px-6 text-right">
    <span class="text-sm <%= item[:color_class] || color_class %> privacy-sensitive">
      <%= Money.new(item[:total], Current.family.currency).format %>
    </span>
  </td>

  <% unless hide_percentage %>
    <td class="py-3 px-4 lg:px-6 text-right">
      <span class="text-sm text-secondary">
        <%= percentage %>%
      </span>
    </td>
  <% end %>
</tr>
