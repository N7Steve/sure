<%# locals: (roboadvisor_metrics:) %>

<% if roboadvisor_metrics[:has_roboadvisors] %>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h3 class="text-xl font-medium"><%= t("reports.roboadvisor_performance.title", default: "Managed Portfolios") %></h3>
    </div>

    <%# Roboadvisor Summary Cards %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <%# Portfolio Value Card %>
      <div class="bg-container-inset rounded-lg p-4">
        <div class="flex items-center gap-2 mb-3">
          <%= icon("briefcase", size: "sm") %>
          <span class="text-sm text-secondary"><%= t("reports.roboadvisor_performance.portfolio_value", default: "Portfolio Value") %></span>
        </div>
        <p class="text-xl font-semibold text-primary privacy-sensitive">
          <%= format_money(roboadvisor_metrics[:portfolio_value]) %>
        </p>
        <% if roboadvisor_metrics[:total_return_trend] %>
          <% total_return_money = Money.new(roboadvisor_metrics[:total_return_trend].value, Current.family.currency) %>
          <p class="text-xs text-gray-500 mt-1 privacy-sensitive">
            <%= t("reports.roboadvisor_performance.estimated_net_value", value: format_money(calculate_estimated_net_liquidity(roboadvisor_metrics[:portfolio_value], total_return_money))) %>
          </p>
        <% end %>
      </div>

      <%# Total Return Card %>
      <div class="bg-container-inset rounded-lg p-4">
        <div class="flex items-center gap-2 mb-3">
          <%= icon("trending-up", size: "sm") %>
          <span class="text-sm text-secondary"><%= t("reports.roboadvisor_performance.total_return", default: "Total Return") %></span>
        </div>
        <% if roboadvisor_metrics[:total_return_trend] %>
          <% total_return_money = Money.new(roboadvisor_metrics[:total_return_trend].value, Current.family.currency) %>
          <p class="text-xl font-semibold privacy-sensitive" style="color: <%= roboadvisor_metrics[:total_return_trend].color %>">
            <%= format_money(total_return_money) %>
            (<%= roboadvisor_metrics[:total_return_trend].percent_formatted %>)
          </p>
          <p class="text-xs text-gray-500 mt-1 privacy-sensitive">
            <%= t("reports.roboadvisor_performance.estimated_net_return", value: format_money(calculate_estimated_net_return(total_return_money))) %>
          </p>
        <% else %>
          <p class="text-xl font-semibold text-secondary"><%= t("reports.roboadvisor_performance.no_data", default: "No Data") %></p>
        <% end %>
      </div>

      <%# Period Return Card %>
      <div class="bg-container-inset rounded-lg p-4">
        <div class="flex items-center gap-2 mb-3">
          <%= icon("chart-line", size: "sm") %>
          <span class="text-sm text-secondary"><%= t("reports.roboadvisor_performance.period_return", default: "Period Return") %></span>
        </div>
        <% period_return = roboadvisor_metrics[:period_return] %>
        <p class="text-xl font-semibold privacy-sensitive" style="color: <%= period_return.amount >= 0 ? 'var(--color-success)' : 'var(--color-destructive)' %>">
          <%= format_money(period_return) %>
        </p>
      </div>

      <%# Period Contributions Card %>
      <div class="bg-container-inset rounded-lg p-4">
        <div class="flex items-center gap-2 mb-3">
          <%= icon("arrow-down-to-line", size: "sm") %>
          <span class="text-sm text-secondary"><%= t("reports.roboadvisor_performance.period_contributions", default: "Period Contributions") %></span>
        </div>
        <p class="text-xl font-semibold text-primary privacy-sensitive">
          <%= format_money(roboadvisor_metrics[:period_contributions]) %>
        </p>
      </div>
    </div>

    <%# Accounts Summary %>
    <div class="space-y-3">
      <h4 class="text-lg font-medium"><%= t("reports.roboadvisor_performance.accounts", default: "Roboadvisor Accounts") %></h4>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        <% roboadvisor_metrics[:accounts].each do |account| %>
          <%= link_to account_path(account), class: "bg-container-inset rounded-lg p-4 flex items-center justify-between hover:bg-container-hover transition-colors" do %>
            <div class="flex items-center gap-3">
              <%= render "accounts/logo", account: account, size: "sm" %>
              <div>
                <p class="font-medium text-primary text-sm"><%= account.name %></p>
                <p class="text-xs text-secondary"><%= account.short_subtype_label %></p>
              </div>
            </div>
            <p class="font-medium text-primary privacy-sensitive"><%= format_money(account.balance_money) %></p>
          <% end %>
        <% end %>
      </div>
    </div>
    <% if roboadvisor_metrics[:transfers].present? && roboadvisor_metrics[:transfers].any? %>
      <div class="space-y-3 mt-6">
        <h4 class="text-lg font-medium"><%= t("reports.roboadvisor_performance.transfers", default: "Transfers") %></h4>
        <div class="bg-container-inset rounded-xl p-1 overflow-x-auto">
          <div class="rounded-lg shadow-border-xs bg-container overflow-hidden">
            <table class="w-full">
              <tbody>
                <% roboadvisor_metrics[:transfers].each_with_index do |transfer, idx| %>
                  <tr class="text-secondary text-sm <%= idx < roboadvisor_metrics[:transfers].size - 1 ? 'table-divider' : '' %>">
                    <td class="py-3 px-4 lg:px-6">
                      <div class="flex items-center gap-1.5 text-sm w-full">
                         <%= render "accounts/logo", account: transfer[:outflow_account], size: "sm" %>
                         <span class="<%= transfer[:outflow_account].excluded? ? 'text-subdued' : 'text-primary font-medium' %> truncate">
                           <%= transfer[:outflow_account].name %>
                           <% if transfer[:outflow_account].excluded? %>
                             <%= icon "ban", class: "w-3.5 h-3.5 inline ml-0.5 text-subdued mb-0.5", title: "Excluded account" %>
                           <% end %>
                         </span>
                         
                         <%= icon "arrow-right", class: "w-3 h-3 text-subdued mx-1 shrink-0" %>
                         
                         <%= render "accounts/logo", account: transfer[:inflow_account], size: "sm" %>
                         <span class="<%= transfer[:inflow_account].excluded? ? 'text-subdued' : 'text-primary font-medium' %> truncate">
                           <%= transfer[:inflow_account].name %>
                           <% if transfer[:inflow_account].excluded? %>
                             <%= icon "ban", class: "w-3.5 h-3.5 inline ml-0.5 text-subdued mb-0.5", title: "Excluded account" %>
                           <% end %>
                         </span>
                         
                         <span class="text-xs text-subdued whitespace-nowrap ml-1">
                           (<%= t("reports.transactions_breakdown.table.entries", count: transfer[:count]) %>)
                         </span>
                       </div>
                    </td>
                    <td class="py-3 px-4 lg:px-6 text-right">
                      <span class="text-sm font-medium text-primary privacy-sensitive">
                        <%= format_money(transfer[:amount]) %>
                      </span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
