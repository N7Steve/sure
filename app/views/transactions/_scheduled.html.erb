<%# Scheduled payments tab — unified view of occurrences in selected month %>

<%# Month selector %>
<div class="flex items-center justify-between mb-4">
  <div class="flex items-center gap-2">
    <%= link_to transactions_path(tab: "scheduled", scheduled_month: (@scheduled_month - 1.month).beginning_of_month.to_s),
        class: "p-1.5 rounded-md hover:bg-surface-hover text-secondary",
        data: { turbo_frame: "_top" } do %>
      <%= icon "chevron-left", size: "sm" %>
    <% end %>

    <h3 class="text-sm font-medium text-primary min-w-[140px] text-center">
      <%= I18n.l(@scheduled_month, format: "%B %Y").capitalize %>
    </h3>

    <%= link_to transactions_path(tab: "scheduled", scheduled_month: (@scheduled_month + 1.month).beginning_of_month.to_s),
        class: "p-1.5 rounded-md hover:bg-surface-hover text-secondary",
        data: { turbo_frame: "_top" } do %>
      <%= icon "chevron-right", size: "sm" %>
    <% end %>
  </div>

  <% if @scheduled_month.beginning_of_month != Date.current.beginning_of_month %>
    <%= link_to t("scheduled_payments.today", default: "Today"),
        transactions_path(tab: "scheduled"),
        class: "text-xs text-link hover:underline" %>
  <% end %>
</div>

<% if @scheduled_occurrences.any? %>
  <div id="scheduled-occurrences" class="flex flex-col bg-container rounded-xl shadow-border-xs px-3 py-4 lg:p-4">
    <%# Header row %>
    <div class="grid-cols-12 bg-container-inset rounded-xl px-5 py-3 text-xs uppercase font-medium text-secondary items-center mb-4 grid">
      <p class="col-span-5"><%= t("scheduled_payments.table.payment", default: "Payment") %></p>
      <p class="col-span-2"><%= t("scheduled_payments.table.date", default: "Date") %></p>
      <p class="col-span-1"><%= t("scheduled_payments.table.status", default: "Status") %></p>
      <p class="col-span-2 justify-self-end"><%= t("transactions.show.amount") %></p>
      <p class="col-span-2 text-right"><%= t("scheduled_payments.table.actions") %></p>
    </div>

    <%# Occurrence rows %>
    <div class="bg-container-inset rounded-xl p-1">
      <div class="bg-container shadow-border-xs rounded-lg divide-y divide-subdued">
        <% @scheduled_occurrences.each do |occurrence| %>
          <%= render "transactions/scheduled_occurrence_row", occurrence: occurrence %>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <div class="flex flex-col items-center justify-center py-20">
    <p class="text-secondary text-sm">
      <%= t("scheduled_payments.empty_month", default: "No scheduled payments for this month") %>
    </p>
  </div>
<% end %>
