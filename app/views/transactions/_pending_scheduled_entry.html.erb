<div class="flex items-center justify-between p-3 bg-yellow-50 rounded-lg border border-yellow-200">
  <div class="flex items-center gap-3">
    <span class="text-sm font-medium"><%= entry.scheduled_payment.title %></span>
    <span class="text-xs text-secondary"><%= l(entry.scheduled_date, format: :short) %></span>
    <span class="badge bg-amber-100 text-amber-700"><%= t("scheduled_payments.badge_pending", default: "Pending") %></span>
  </div>
  <div class="flex items-center gap-2">
    <span class="font-medium"><%= format_money(entry.scheduled_payment.amount_money) %></span>
    <%= button_to confirm_entry_scheduled_payment_path(entry.scheduled_payment, entry_id: entry.id),
        method: :post, class: "text-success hover:bg-green-50 rounded p-1" do %>
      <%= icon "check", size: "sm" %>
    <% end %>
    <%= button_to reject_entry_scheduled_payment_path(entry.scheduled_payment, entry_id: entry.id),
        method: :post, class: "text-destructive hover:bg-red-50 rounded p-1" do %>
      <%= icon "x", size: "sm" %>
    <% end %>
  </div>
</div>
