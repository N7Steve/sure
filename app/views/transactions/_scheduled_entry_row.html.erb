<%# locals: (pending:) %>
<% sp = pending.scheduled_payment %>
<% is_dismissed = pending.skipped? || pending.rejected? %>
<div class="group flex lg:grid lg:grid-cols-12 items-center text-sm font-medium p-3 lg:p-4 <%= is_dismissed ? 'opacity-50 bg-surface-inset' : 'text-primary' %>">
  <%# Name + badge %>
  <div class="pr-4 lg:pr-10 flex items-center gap-3 lg:gap-4 col-span-6 min-w-0">
    <% if sp.merchant.present? && sp.merchant.respond_to?(:logo_url) && sp.merchant.logo_url.present? %>
      <%= image_tag Setting.transform_brand_fetch_url(sp.merchant.logo_url),
          class: "w-9 h-9 rounded-full", loading: "lazy" %>
    <% else %>
      <%= render DS::FilledIcon.new(variant: :text, text: sp.title, size: "lg", rounded: true) %>
    <% end %>
    <div class="truncate">
      <div class="flex items-center gap-1 min-w-0">
        <div class="truncate flex-shrink"><%= sp.title %></div>
        <% if is_dismissed %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500 flex-shrink-0">
            <%= t("scheduled_payments.badge_skipped", default: "Skipped") %>
          </span>
        <% else %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700 flex-shrink-0">
            <%= t("scheduled_payments.badge_pending") %>
          </span>
        <% end %>
      </div>
      <div class="text-secondary text-xs font-normal">
        <%= sp.account.name %>
        <% if sp.transfer? && sp.target_account.present? %> → <%= sp.target_account.name %><% end %>
      </div>
    </div>
  </div>

  <%# Type badge %>
  <div class="hidden lg:flex items-center gap-1 col-span-2">
    <span class="text-xs text-secondary"><%= t("scheduled_payments.form.payment_types.#{sp.payment_type}", default: sp.payment_type.humanize) %></span>
  </div>

  <%# Amount %>
  <div class="col-span-2 ml-auto text-right shrink-0">
    <p class="font-medium privacy-sensitive <%= is_dismissed ? 'text-secondary line-through' : (sp.income? ? 'text-success' : 'text-subdued') %>">
      <%= format_money(sp.expense? ? -sp.amount_money : sp.amount_money) %>
    </p>
  </div>

  <%# Action buttons %>
  <div class="col-span-2 flex items-center justify-end gap-2">
    <% if is_dismissed %>
      <%# Re-confirm button for dismissed entries %>
      <%= button_to confirm_entry_scheduled_payment_path(sp, entry_id: pending.id),
          method: :post,
          class: "text-success hover:text-green-700 transition-colors",
          title: t("scheduled_payments.restore_action", default: "Restore & confirm") do %>
        <%= icon "rotate-ccw", size: "sm" %>
      <% end %>
    <% else %>
      <%# Confirm / Reject buttons for pending entries %>
      <%= button_to confirm_entry_scheduled_payment_path(sp, entry_id: pending.id),
          method: :post,
          class: "text-success hover:text-green-700 transition-colors",
          title: t("scheduled_payments.confirm_action", default: "Confirm") do %>
        <%= icon "circle-check", size: "sm" %>
      <% end %>
      <%= button_to reject_entry_scheduled_payment_path(sp, entry_id: pending.id),
          method: :post,
          class: "text-destructive hover:text-red-700 transition-colors",
          title: t("scheduled_payments.reject_action", default: "Reject") do %>
        <%= icon "circle-x", size: "sm" %>
      <% end %>
    <% end %>
  </div>
</div>
