<%# locals: (entries:) %>

<div class="bg-container-hover rounded-xl overflow-x-auto shadow-xs" style="border: 1px solid var(--color-alpha-white-200);">
  <table class="w-full text-sm text-left">
    <thead class="text-xs text-secondary uppercase font-medium" style="background-color: color-mix(in srgb, var(--color-alpha-white-200) 60%, transparent);">
      <tr>
        <th class="px-4 py-2 w-28 whitespace-nowrap"><%= t("transactions.show.date_label", default: "Date") %></th>
        <th class="px-4 py-2 hidden md:table-cell"><%= t("transactions.show.merchant_label", default: "Merchant") %></th>
        <th class="px-4 py-2"><%= t("transactions.show.name_label", default: "Name") %></th>
        <th class="px-4 py-2 hidden md:table-cell"><%= t("transactions.show.account_label", default: "Account") %></th>
        <th class="px-4 py-2 hidden md:table-cell"><%= t("transactions.form.category_label", default: "Category") %></th>
        <th class="px-4 py-2 text-right"><%= t("transactions.show.amount", default: "Amount") %></th>
      </tr>
    </thead>
    <tbody style="border-top: 1px solid var(--color-alpha-white-200);">
      <% entries.each_with_index do |entry, idx| %>
        <%
           is_last_of_day = (idx == entries.size - 1) || (entry.date != entries[idx + 1].date)
           border_class = is_last_of_day ? "" : ""
           row_style = is_last_of_day ? "border-bottom: 3px solid var(--color-alpha-white-200);" : "border-bottom: 1px solid var(--color-alpha-white-200);"
        %>
        <tr class="group" style="<%= row_style %>" onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--color-alpha-white-200) 30%, transparent)'" onmouseout="this.style.backgroundColor=''">
          <td class="px-4 py-2 whitespace-nowrap text-secondary text-xs align-middle">
            <%= entry.date.strftime(Current.family.date_format) %>
          </td>
          <td class="px-4 py-2 hidden md:table-cell text-secondary truncate max-w-[150px] align-middle">
             <% if entry.entryable_type == "Transaction" %>
               <% transaction = entry.entryable %>
               <% if transaction.transfer? %>
                 <div class="flex items-center gap-2">
                   <%= icon "arrow-right-left", size: "sm", class: "shrink-0", color: "current" %>
                   <span class="truncate"><%= transaction.transfer&.payment? ? t("transactions.show.loan_payment", default: "Payment") : t("transactions.show.transfer", default: "Transfer") %></span>
                 </div>
               <% elsif transaction.merchant.present? %>
                 <div class="flex items-center gap-2">
                   <% if transaction.merchant.logo_url.present? %>
                     <%= image_tag Setting.transform_brand_fetch_url(transaction.merchant.logo_url),
                         class: "w-5 h-5 rounded-full border border-secondary shrink-0",
                         loading: "lazy" %>
                   <% end %>
                   <span class="truncate"><%= transaction.merchant.name %></span>
                 </div>
               <% end %>
             <% end %>
          </td>
          <td class="px-4 py-2 font-medium min-w-[200px] align-middle">
            <div class="flex items-center gap-2">
              <% if entry.entryable_type == "Transaction" && entry.entryable.pending? %>
                <span class="w-1.5 h-1.5 rounded-full bg-secondary shrink-0" title="<%= t("transactions.transaction.pending") %>"></span>
              <% end %>
              <%= link_to entry.name, entry_path(entry), data: { turbo_frame: "drawer", turbo_prefetch: false }, class: "hover:underline text-primary truncate" %>
              
              <% if entry.entryable_type == "Transaction" && entry.entryable.transfer.present? %>
                 <%= render "transactions/transfer_match", transaction: entry.entryable %>
              <% end %>
            </div>
          </td>
          <td class="px-4 py-2 hidden md:table-cell text-secondary truncate max-w-[150px] align-middle">
            <%= entry.account.name %>
          </td>
          <td class="px-4 py-2 hidden md:table-cell truncate max-w-[150px] align-middle">
            <% if entry.entryable_type == "Transaction" %>
               <div class="flex items-center min-w-0">
                 <%= render "transactions/transaction_category", transaction: entry.entryable, variant: "desktop" %>
               </div>
            <% else %>
              <span class="text-secondary"><%= entry.entryable_type %></span>
            <% end %>
          </td>
          <td class="px-4 py-2 text-right align-middle">
            <p class="font-bold text-sm privacy-sensitive whitespace-nowrap <%= entry.amount.positive? ? "text-red-600 dark:text-red-500" : "text-green-600 dark:text-green-500" %>">
              <%= format_money(-entry.amount_money) %>
            </p>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
