<%# locals: (account_group:, mobile: false, all_tab: false, open: nil, **args) %>

<% sidebar_accounts = account_group.accounts.reject(&:archived?) %>
<% if sidebar_accounts.any? %>
<div id="<%= account_group.dom_id(tab: all_tab ? :all : nil, mobile: mobile) %>">
  <% is_open = open.nil? ? sidebar_accounts.any? { |account| page_active?(account_path(account)) } : open %>
  <% disclosure_context = all_tab ? "all" : account_group.classification %>
  <% disclosure_key = ["account-sidebar", Current.user.id, mobile ? "mobile" : "desktop", disclosure_context, account_group.key].join("-") %>
  <%= render DS::Disclosure.new(
        align: :left,
        open: is_open,
        animated: true,
        data: {
          controller: "persisted-disclosure",
          persisted_disclosure_key_value: disclosure_key,
          action: "turbo:before-morph-attribute->persisted-disclosure#preserveOpen"
        }
      ) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center gap-2">
        <%= icon "chevron-right", class: "group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-200 motion-safe:ease-out" %>
        <%= icon account_group.icon, class: "w-4 h-4 text-secondary" %>
        <%= tag.span class: class_names("text-sm text-primary font-medium", "animate-pulse" => account_group.syncing?) do %>
          <%= account_group.name %>
        <% end %>
      </div>

      <div class="ml-auto text-right">
        <%= tag.p format_money(account_group.total_money), class: "text-sm font-medium text-primary privacy-sensitive" %>
      </div>
    <% end %>

    <div class="space-y-1">
      <% sidebar_accounts.each do |account| %>
        <%= link_to account_path(account),
                  class: class_names(
                    "block flex items-center gap-2 px-3 py-2 rounded-lg",
                    page_active?(account_path(account)) ? "bg-container" : "hover:bg-surface-hover"
                  ),
                  title: account.name do %>
          <%= render "accounts/logo", account: account, size: "sm", color: account_group.color %>

          <div class="min-w-0 grow">
            <div class="flex items-center gap-2 mb-0.5">
              <%= tag.p account.name, class: class_names("text-sm text-primary font-medium truncate", "animate-pulse" => account.syncing?) %>
              <% if account.shared? %>
                <%= icon("users", class: "w-3 h-3 text-secondary shrink-0") %>
              <% end %>
            </div>
            <div class="flex items-center gap-1">
              <%= tag.p account.short_subtype_label, class: "text-sm text-secondary truncate min-w-0" %>
              <% if account.cashflow_boundary? %>
                <%= render DS::Tooltip.new(
                      text: t("accounts.account.outside_finances_indicator", default: "Outside my finances"),
                      icon: "info",
                      size: "xs",
                      as: :span
                    ) %>
              <% end %>
            </div>
          </div>

          <div class="ml-auto text-right grow h-10">
            <%= tag.p format_money(account.balance_money), class: "text-sm font-medium text-primary whitespace-nowrap privacy-sensitive" %>
            <%= turbo_frame_tag dom_id(account, :sparkline), src: sparkline_account_path(account), loading: "lazy", data: { controller: "turbo-frame-timeout", turbo_frame_timeout_timeout_value: 10000 } do %>
              <div class="flex items-center w-8 h-4 ml-auto">
                <div class="w-6 h-px bg-loader"></div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

  <% end %>
</div>
<% end %>
