<div class="space-y-4">
  <div class="flex flex-wrap gap-2">
    <% %i[scheduled confirmed skipped overdue].each do |status| %>
      <%= render DS::Pill.new(label: t("scheduled_payments.status.#{status}"), tone: agenda_status_tone(status), marker: false) %>
    <% end %>
  </div>

  <div class="hidden md:block">
    <%= render DS::Card.new(class: "overflow-hidden") do %>
      <div class="grid grid-cols-7">
        <% @agenda.days.first(7).each do |day| %>
          <div class="p-2 text-center text-sm font-medium text-secondary"><%= t("date.abbr_day_names")[day.date.wday] %></div>
        <% end %>
        <% @agenda.days.each do |day| %>
          <div class="min-h-24 min-w-0 border-t border-primary p-2 <%= day.in_month ? 'bg-container' : 'bg-surface-inset' %>" data-agenda-day="<%= day.date.iso8601 %>">
            <time datetime="<%= day.date.iso8601 %>" class="text-sm <%= day.date == Date.current ? 'font-bold text-link' : 'text-secondary' %>" <%= 'aria-current=date' if day.date == Date.current %>><%= day.date.day %></time>
            <div class="mt-2 space-y-1 text-center">
              <%= render partial: "scheduled_payments/calendar_chip", collection: day.occurrences, as: :occurrence %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="space-y-3 md:hidden">
    <% if @agenda.occupied_month_days.empty? %>
      <%= render DS::EmptyState.new(icon: "calendar-days", title: t("scheduled_payments.agenda.empty_month")) %>
    <% end %>
    <% @agenda.occupied_month_days.each do |day| %>
      <%= render DS::Card.new do %>
        <h2 class="mb-3 text-sm font-medium text-primary"><time datetime="<%= day.date.iso8601 %>"><%= l(day.date, format: :long) %></time></h2>
        <div class="space-y-2 text-center">
          <%= render partial: "scheduled_payments/calendar_chip", collection: day.occurrences, as: :occurrence %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
