<%= content_for :page_title, t("scheduled_payments.title") %>
<div class="space-y-6">
  <header class="flex items-center justify-between">
    <h1 class="text-xl font-semibold"><%= t("scheduled_payments.title") %></h1>
    <%= render DS::Link.new(text: t("scheduled_payments.new"), icon: "plus", variant: "primary", href: new_scheduled_payment_path) %>
  </header>

  <% if @pending_entries.any? %>
    <section class="space-y-2">
      <h2 class="text-sm font-medium text-secondary uppercase"><%= t("scheduled_payments.pending_section") %></h2>
      <% @pending_entries.each do |e| %>
        <%= render "transactions/pending_scheduled_entry", entry: e %>
      <% end %>
    </section>
  <% end %>

  <% if @scheduled_payments.any? %>
    <section class="bg-container rounded-xl shadow-border-xs">
      <div class="grid grid-cols-12 bg-container-inset rounded-t-xl px-5 py-3 text-xs uppercase font-medium text-secondary items-center">
        <div class="col-span-4"><%= t("scheduled_payments.table.title") %></div>
        <div class="col-span-2"><%= t("scheduled_payments.table.account") %></div>
        <div class="col-span-2"><%= t("scheduled_payments.table.next_run") %></div>
        <div class="col-span-1"><%= t("scheduled_payments.table.amount") %></div>
        <div class="col-span-1"><%= t("scheduled_payments.table.status", default: "Status") %></div>
        <div class="col-span-2 text-right"><%= t("scheduled_payments.table.actions") %></div>
      </div>
      <div class="divide-y">
        <% @scheduled_payments.each do |sp| %>
          <div class="grid grid-cols-12 px-5 py-3 items-center">
            <div class="col-span-4 flex items-center gap-2">
              <%= icon("calendar", size: :sm, color: :current) %>
              <span class="font-medium"><%= sp.title %></span>
              <span class="text-xs text-secondary uppercase"><%= sp.frequency %></span>
              <% pending_count = @pending_counts[sp.id] || 0 %>
              <% if pending_count > 0 %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">
                  <%= pending_count %> <%= t("scheduled_payments.badge_pending") %>
                </span>
              <% end %>
            </div>
            <div class="col-span-2 text-secondary"><%= sp.account.name %></div>
            <div class="col-span-2 text-secondary"><%= l(sp.next_run_date) %></div>
            <div class="col-span-1 font-medium <%= sp.income? ? 'text-success' : '' %>">
              <%= format_money(sp.expense? ? -sp.amount_money : sp.amount_money) %>
            </div>
            <div class="col-span-1">
              <% if sp.active? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-50 text-success"><%= t("scheduled_payments.status.active", default: "Active") %></span>
              <% elsif sp.paused? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-50 text-amber-700"><%= t("scheduled_payments.status.paused", default: "Paused") %></span>
              <% elsif sp.completed? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-inset text-secondary"><%= t("scheduled_payments.status.completed", default: "Completed") %></span>
              <% end %>
            </div>
            <div class="col-span-2 flex items-center gap-2 justify-end">
              <%= render DS::Link.new(variant: "outline", icon: "pencil", href: edit_scheduled_payment_path(sp)) %>
              <% unless sp.completed? %>
                <%= link_to toggle_status_scheduled_payment_path(sp),
                    data: { turbo_method: :post },
                    class: "text-secondary hover:text-primary" do %>
                  <%= icon sp.active? ? "pause" : "play", size: "sm" %>
                <% end %>
              <% end %>
              <%= link_to scheduled_payment_path(sp),
                  data: { turbo_method: :delete, turbo_confirm: t("scheduled_payments.confirm_delete") },
                  class: "text-secondary hover:text-destructive" do %>
                <%= icon "trash-2", size: "sm" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% else %>
    <section class="bg-container rounded-xl shadow-border-xs p-8">
      <div class="text-center">
        <div class="flex justify-center text-secondary mb-4">
          <%= icon "calendar", size: "xl" %>
        </div>
        <p class="text-primary font-medium mb-2"><%= t("scheduled_payments.empty.title", default: "No scheduled payments") %></p>
        <p class="text-secondary text-sm mb-4"><%= t("scheduled_payments.empty.description", default: "Create a scheduled payment to automatically generate recurring transactions on a set schedule.") %></p>
        <%= render DS::Link.new(text: t("scheduled_payments.new"), icon: "plus", variant: "primary", href: new_scheduled_payment_path) %>
      </div>
    </section>
  <% end %>
</div>
