<%= content_for :page_title, t("scheduled_payments.title") %>

<%= content_for :page_actions do %>
  <%= link_to run_now_scheduled_payments_path,
      data: { turbo_method: :post },
      class: "inline-flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium text-secondary border border-secondary hover:bg-surface-hover transition-colors",
      title: t("scheduled_payments.run_now_hint", default: "Manually trigger scheduled payments job") do %>
    <%= icon "play", size: "sm" %>
    <span><%= t("scheduled_payments.run_now", default: "Run job now") %></span>
  <% end %>
  <%= render DS::Link.new(text: t("scheduled_payments.new"), icon: "plus", variant: "primary", href: new_scheduled_payment_path) %>
<% end %>

<div class="space-y-4 flex flex-col">
  <% if @pending_entries.any? %>
    <div class="p-4 bg-container-inset border border-secondary rounded-lg">
      <div class="flex items-start gap-2">
        <%= icon "clock", class: "w-5 h-5 text-amber-500 mt-0.5 flex-shrink-0" %>
        <div class="w-full space-y-2">
          <p class="text-sm font-medium text-primary"><%= t("scheduled_payments.pending_section") %> (<%= @pending_entries.size %>)</p>
          <% @pending_entries.each do |e| %>
            <%= render "transactions/pending_scheduled_entry", entry: e %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @scheduled_payments.any? %>
    <div class="bg-container rounded-xl shadow-border-xs p-4">
      <div class="rounded-xl bg-container-inset p-1">
        <div class="bg-container rounded-lg shadow-border-xs divide-y divide-subdued">
          <% @scheduled_payments.each do |sp| %>
            <% pending_count = @pending_counts[sp.id] || 0 %>
            <% oldest_pending = @oldest_pending_per_sp[sp.id] %>

            <div class="p-4 hover:bg-surface-hover transition-colors <%= 'opacity-60' unless sp.active? %>">
              <%# === Row 1: Icon + Title | Frequency + Pending | Amount === %>
              <div class="grid grid-cols-12 items-center gap-2 mb-2">
                <%# Col 1-6: Icon + Title %>
                <div class="col-span-6 flex items-center gap-3 min-w-0">
                  <div class="flex-shrink-0">
                    <% if sp.transfer? %>
                      <%= render DS::FilledIcon.new(
                        icon: "arrow-right-left",
                        hex_color: Category::TRANSFER_COLOR,
                        size: "sm",
                        rounded: true
                      ) %>
                    <% elsif sp.merchant.present? && sp.merchant.respond_to?(:logo_url) && sp.merchant.logo_url.present? %>
                      <%= image_tag Setting.transform_brand_fetch_url(sp.merchant.logo_url),
                          class: "w-6 h-6 rounded-full", loading: "lazy" %>
                    <% elsif sp.merchant.present? %>
                      <%= render DS::FilledIcon.new(variant: :text, text: sp.merchant.name, size: "sm", rounded: true) %>
                    <% else %>
                      <%= render DS::FilledIcon.new(variant: :text, text: sp.title, size: "sm", rounded: true) %>
                    <% end %>
                  </div>
                  <span class="text-sm text-primary font-medium truncate"><%= sp.title %></span>
                </div>

                <%# Col 7-9: Frequency + Pending badges %>
                <div class="col-span-3 flex items-center gap-2">
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium text-secondary bg-surface-inset uppercase flex-shrink-0">
                    <%= t("scheduled_payments.form.frequencies.#{sp.frequency}", default: sp.frequency) %>
                  </span>
                  <% if pending_count > 0 %>
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700 flex-shrink-0">
                      <%= pending_count %> <%= t("scheduled_payments.status.pending", default: "pending") %>
                    </span>
                  <% end %>
                </div>

                <%# Col 10-12: Amount %>
                <div class="col-span-3 text-right">
                  <span class="text-sm font-medium privacy-sensitive <%= sp.income? ? 'text-success' : 'text-primary' %>">
                    <%= format_money(sp.expense? ? -sp.amount_money : sp.amount_money) %>
                  </span>
                </div>
              </div>

              <%# === Row 2: Account + details | Status | Date + Actions === %>
              <div class="grid grid-cols-12 items-center gap-2">
                <%# Col 1-6: Account icons + Merchant + Category %>
                <div class="col-span-6 flex items-center gap-2 text-xs text-secondary min-w-0">
                  <div data-controller="tooltip" data-tooltip-placement-value="top" class="flex-shrink-0 cursor-default">
                    <div class="w-5 h-5 [&_img]:w-5 [&_img]:h-5 [&_.w-6]:w-5 [&_.h-6]:h-5">
                      <%= render "accounts/logo", account: sp.account, size: "sm" %>
                    </div>
                    <%= render "shared/text_tooltip", tooltip_text: sp.account.name %>
                  </div>

                  <% if sp.transfer? && sp.target_account.present? %>
                    <span class="text-secondary">→</span>
                    <div data-controller="tooltip" data-tooltip-placement-value="top" class="flex-shrink-0 cursor-default">
                      <div class="w-5 h-5 [&_img]:w-5 [&_img]:h-5 [&_.w-6]:w-5 [&_.h-6]:h-5">
                        <%= render "accounts/logo", account: sp.target_account, size: "sm" %>
                      </div>
                      <%= render "shared/text_tooltip", tooltip_text: sp.target_account.name %>
                    </div>
                  <% end %>

                  <% if sp.merchant.present? %>
                    <span class="truncate text-secondary"><%= sp.merchant.name %></span>
                  <% end %>

                  <% if sp.category.present? %>
                    <span class="inline-flex items-center gap-0.5 text-xs font-medium rounded-full px-1.5 py-0.5 border max-w-[140px]"
                          style="background-color: color-mix(in oklab, <%= sp.category.color %> 10%, transparent);
                                 border-color: color-mix(in oklab, <%= sp.category.color %> 10%, transparent);
                                 color: <%= sp.category.color %>;">
                      <% if sp.category.lucide_icon.present? %>
                        <span class="shrink-0"><%= icon sp.category.lucide_icon, size: "sm", color: "current" %></span>
                      <% end %>
                      <span class="truncate"><%= sp.category.name %></span>
                    </span>
                  <% end %>
                </div>

                <%# Col 7-9: Status + Date %>
                <div class="col-span-3 flex items-center gap-2">
                  <% if sp.active? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-green-50 text-success">
                      <%= t("scheduled_payments.status.active", default: "Active") %>
                    </span>
                  <% elsif sp.paused? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-amber-50 text-amber-700">
                      <%= t("scheduled_payments.status.paused", default: "Paused") %>
                    </span>
                  <% elsif sp.completed? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-surface-inset text-secondary">
                      <%= t("scheduled_payments.status.completed", default: "Completed") %>
                    </span>
                  <% end %>
                  <span class="text-xs text-secondary"><%= l(sp.next_run_date, format: :short) %></span>
                </div>

                <%# Col 10-12: Actions %>
                <div class="col-span-3 flex items-center justify-end gap-1.5">
                  <% if oldest_pending %>
                    <%= button_to confirm_entry_scheduled_payment_path(sp, entry_id: oldest_pending.id),
                        method: :post,
                        class: "text-success hover:text-green-700 transition-colors",
                        title: t("scheduled_payments.confirm_action", default: "Confirm") do %>
                      <%= icon "circle-check", size: "sm" %>
                    <% end %>
                    <%= button_to reject_entry_scheduled_payment_path(sp, entry_id: oldest_pending.id),
                        method: :post,
                        class: "text-destructive hover:text-red-700 transition-colors",
                        title: t("scheduled_payments.reject_action", default: "Reject") do %>
                      <%= icon "circle-x", size: "sm" %>
                    <% end %>
                  <% end %>
                  <%= link_to edit_scheduled_payment_path(sp),
                      class: "text-secondary hover:text-primary transition-colors" do %>
                    <%= icon "pencil", size: "sm" %>
                  <% end %>
                  <% unless sp.completed? %>
                    <%= link_to toggle_status_scheduled_payment_path(sp),
                        data: { turbo_method: :post },
                        class: "text-secondary hover:text-primary transition-colors" do %>
                      <%= icon sp.active? ? "pause" : "play", size: "sm" %>
                    <% end %>
                  <% end %>
                  <%= link_to scheduled_payment_path(sp),
                      data: { turbo_method: :delete, turbo_confirm: t("scheduled_payments.confirm_delete") },
                      class: "text-secondary hover:text-destructive transition-colors" do %>
                    <%= icon "trash-2", size: "sm" %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="bg-container rounded-xl shadow-border-xs p-4">
      <div class="text-center py-12">
        <div class="flex justify-center text-secondary mb-4">
          <%= icon "calendar", size: "xl" %>
        </div>
        <p class="text-primary font-medium mb-2"><%= t("scheduled_payments.empty.title", default: "No scheduled payments") %></p>
        <p class="text-secondary text-sm mb-4"><%= t("scheduled_payments.empty.description", default: "Create a scheduled payment to automatically generate recurring transactions on a set schedule.") %></p>
        <%= render DS::Link.new(text: t("scheduled_payments.new"), icon: "plus", variant: "primary", href: new_scheduled_payment_path) %>
      </div>
    </div>
  <% end %>
</div>
