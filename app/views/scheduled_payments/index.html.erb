<%= content_for :page_title, t("scheduled_payments.agenda.title") %>

<div class="space-y-6 pb-6 lg:pb-12">
  <header class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-medium text-primary"><%= t("scheduled_payments.agenda.title") %></h1>
      <p class="mt-1 text-sm text-secondary"><%= t("scheduled_payments.agenda.subtitle") %></p>
    </div>
    <%= render DS::Link.new(text: t("scheduled_payments.agenda.new"), icon: "plus", variant: "primary",
          href: new_scheduled_payment_path(**agenda_context_params)) %>
  </header>

  <div class="overflow-x-auto">
    <%= render DS::SegmentedControl.new(aria_label: t("scheduled_payments.agenda.views_label"), class: "w-max") do |control| %>
      <% ScheduledPayment::Agenda::VIEWS.each do |view| %>
        <% control.with_segment(t("scheduled_payments.agenda.views.#{view}"), active: @view == view,
             href: scheduled_payments_path(view: view, month: @agenda.month.iso8601)) %>
      <% end %>
    <% end %>
  </div>

  <% if @view == "schedules" %>
    <%= render "scheduled_payments/schedules" %>
  <% else %>
    <%= render "scheduled_payments/month_navigation" %>

    <% if @view == "calendar" %>
      <%= render "scheduled_payments/calendar" %>
    <% else %>
      <div class="grid gap-3 md:grid-cols-3">
        <% agenda_metrics.each do |metric| %>
          <%= render DS::Card.new do %>
            <h2 class="text-sm font-medium text-secondary"><%= t("scheduled_payments.agenda.metrics.#{metric[:key]}") %></h2>
            <div class="my-2 space-y-1 text-2xl font-semibold text-primary privacy-sensitive" data-agenda-metric="<%= metric[:key] %>">
              <% metric[:values].each do |value| %><p><%= value %></p><% end %>
            </div>
            <p class="text-xs text-secondary"><%= metric[:hint] %></p>
          <% end %>
        <% end %>
      </div>

      <% if @agenda.older_pending.any? %>
        <%= render DS::Alert.new(variant: :warning) do %>
          <p><%= t("scheduled_payments.agenda.older_pending", count: @agenda.older_pending.size) %></p>
          <%= render DS::Link.new(text: t("scheduled_payments.agenda.review_older"), variant: "ghost",
                href: scheduled_payments_path(month: @agenda.older_pending.first.scheduled_date.beginning_of_month.iso8601)) %>
        <% end %>
      <% end %>

      <%= render "scheduled_payments/occurrences", occurrences: @agenda.month_occurrences %>
    <% end %>
  <% end %>
</div>
