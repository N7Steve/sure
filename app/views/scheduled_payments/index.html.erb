<%= content_for :page_title, t("scheduled_payments.agenda.title") %>

<div class="space-y-6 pb-6 lg:pb-12">
  <header class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-medium text-primary"><%= t("scheduled_payments.agenda.title") %></h1>
      <p class="mt-1 text-sm text-secondary"><%= t("scheduled_payments.agenda.subtitle") %></p>
    </div>
    <%= render DS::Link.new(text: t("scheduled_payments.agenda.new"), icon: "plus", variant: "primary",
          href: new_scheduled_payment_path(**agenda_context_params), frame: :modal) %>
  </header>

  <div class="overflow-x-auto">
    <%= render DS::SegmentedControl.new(aria_label: t("scheduled_payments.agenda.views_label"), class: "w-max") do |control| %>
      <% ScheduledPayment::Agenda::VIEWS.each do |view| %>
        <% control.with_segment(t("scheduled_payments.agenda.views.#{view}"), active: @view == view,
             href: scheduled_payments_path(view: view, month: @agenda.month.iso8601)) %>
      <% end %>
    <% end %>
  </div>

  <% if @view == "schedules" %>
    <%= render "scheduled_payments/schedules" %>
  <% else %>
    <%= render "scheduled_payments/month_navigation" %>

    <% if @view == "calendar" %>
      <%= render "scheduled_payments/calendar" %>
    <% else %>
      <%= render "scheduled_payments/metric_cards", metrics: agenda_metrics %>

      <section class="space-y-3" aria-labelledby="agenda-planning-title">
        <div>
          <h2 id="agenda-planning-title" class="text-base font-medium text-primary"><%= t("scheduled_payments.agenda.planning_title") %></h2>
          <p class="mt-1 text-sm text-secondary"><%= t("scheduled_payments.agenda.planning_hint") %></p>
          <% if @agenda.planning_has_estimates? %>
            <p class="mt-1 text-xs text-secondary"><%= t("scheduled_payments.agenda.includes_estimates") %></p>
          <% end %>
        </div>
        <%= render "scheduled_payments/metric_cards", metrics: agenda_planning_metrics %>

        <% if @agenda.planning_breakdown.any? %>
          <%= render DS::Card.new do %>
            <%= render DS::Disclosure.new(title: t("scheduled_payments.agenda.category_breakdown"), align: "left") do %>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead class="text-left text-xs text-secondary">
                    <tr>
                      <th class="py-2 font-medium"><%= t("scheduled_payments.form.category_label") %></th>
                      <th class="py-2 text-right font-medium"><%= t("scheduled_payments.agenda.metrics.monthly_cost") %></th>
                      <th class="py-2 text-right font-medium"><%= t("scheduled_payments.agenda.metrics.annual_cost") %></th>
                      <th class="py-2 text-right font-medium"><%= t("scheduled_payments.agenda.metrics.monthly_provision") %></th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-primary">
                    <% @agenda.planning_breakdown.each do |row| %>
                      <tr>
                        <td class="py-2 text-primary"><%= scheduled_payment_category_name(row) %></td>
                        <td class="py-2 text-right text-primary privacy-sensitive"><%= agenda_planning_row_amount(row, :monthly_amount) %></td>
                        <td class="py-2 text-right text-primary privacy-sensitive"><%= agenda_planning_row_amount(row, :annual_amount) %></td>
                        <td class="py-2 text-right text-primary privacy-sensitive"><%= agenda_planning_row_amount(row, :provision_amount) %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </section>

      <% if @agenda.older_pending.any? %>
        <%= render DS::Alert.new(variant: :warning) do %>
          <p><%= t("scheduled_payments.agenda.older_pending", count: @agenda.older_pending.size) %></p>
          <%= render DS::Link.new(text: t("scheduled_payments.agenda.review_older"), variant: "ghost",
                href: scheduled_payments_path(month: @agenda.older_pending.first.scheduled_date.beginning_of_month.iso8601)) %>
        <% end %>
      <% end %>

      <%= render "scheduled_payments/occurrences", occurrences: @agenda.month_occurrences %>
    <% end %>
  <% end %>
</div>
