<%= render DS::Dialog.new(variant: "modal", width: "sm") do |dialog| %>
  <% dialog.with_header(title: t("scheduled_payments.confirm_modal.title")) %>
  <% dialog.with_body do %>
    <% confirmation_path = @entry_to_confirm.present? ?
         confirm_entry_scheduled_payment_path(@scheduled_payment, entry_id: @entry_to_confirm.id) :
         confirm_scheduled_date_scheduled_payment_path(@scheduled_payment) %>
    <%= styled_form_with url: confirmation_path, method: :post, class: "space-y-4", data: { turbo_frame: "_top" } do |f| %>
      <% agenda_context_params.each do |name, value| %>
        <%= hidden_field_tag name, value %>
      <% end %>
      <%= hidden_field_tag :scheduled_date, @scheduled_date&.iso8601 %>
      <p class="text-sm font-medium text-primary"><%= @scheduled_payment.title %></p>
      <%= f.date_field :confirm_date, value: @default_date, required: true,
            label: t("scheduled_payments.confirm_modal.date_label") %>
      <%= f.number_field :confirm_amount, value: @default_amount, required: true, min: 0, step: "0.01",
            label: t("scheduled_payments.confirm_modal.amount_label") %>
      <% if @scheduled_payment.amount_estimated? %>
        <p class="text-xs text-secondary"><%= t("scheduled_payments.confirm_modal.estimated_hint") %></p>
      <% end %>
      <p class="text-sm text-secondary"><%= @scheduled_payment.currency %></p>
      <div class="flex items-center justify-end gap-2 pt-2">
        <%= render DS::Button.new(text: t("shared.cancel"), variant: "ghost", size: :sm, type: "button", data: { action: "DS--dialog#close" }) %>
        <%= render DS::Button.new(text: t("scheduled_payments.confirm_modal.confirm_button"), variant: "primary", size: :sm, type: "submit") %>
      </div>
    <% end %>
  <% end %>
<% end %>
