<%= styled_form_with model: scheduled_payment,
    url: scheduled_payment.persisted? ? scheduled_payment_path(scheduled_payment) : scheduled_payments_path,
    class: "space-y-4",
    data: { controller: "scheduled-payment-form" } do |f| %>

  <% if scheduled_payment.errors.any? %>
    <%= render "shared/form_errors", model: scheduled_payment %>
  <% end %>

  <section class="space-y-2">
    <%= f.text_field :title,
        label: t("scheduled_payments.form.title_label"),
        placeholder: t("scheduled_payments.form.title_placeholder"),
        required: true %>

    <%= f.collection_select :account_id,
        Current.user.accessible_accounts.alphabetically,
        :id, :name,
        { prompt: t("scheduled_payments.form.select_account"),
          label: t("scheduled_payments.form.account_label"),
          variant: :logo },
        { required: true } %>

    <%= f.number_field :amount,
        label: t("scheduled_payments.form.amount_label"),
        required: true,
        min: 0,
        step: "0.01",
        placeholder: "10.00" %>

    <%= f.select :currency,
        currency_picker_options_for_family,
        { label: t("scheduled_payments.form.currency_label") } %>

    <%= f.collection_select :category_id,
        Current.family.categories.alphabetically,
        :id, :name,
        { prompt: t("scheduled_payments.form.select_category"),
          label: t("scheduled_payments.form.category_label"),
          variant: :badge,
          searchable: true } %>

    <%= f.collection_select :merchant_id,
        Current.family.available_merchants_for(Current.user).alphabetically,
        :id, :name,
        { include_blank: t("scheduled_payments.form.no_merchant"),
          label: t("scheduled_payments.form.merchant_label"),
          variant: :logo,
          searchable: true } %>

    <%= f.select :payment_type,
        ScheduledPayment.payment_types.keys.map { |k| [t("scheduled_payments.form.payment_types.#{k}"), k] },
        { label: t("scheduled_payments.form.payment_type_label") },
        { required: true,
          data: { scheduled_payment_form_target: "paymentType",
                  action: "change->scheduled-payment-form#toggleTransferFields" } } %>

    <div data-scheduled-payment-form-target="transferFields"
         class="<%= 'hidden' unless scheduled_payment.transfer? %>">
      <%= f.collection_select :target_account_id,
          Current.user.accessible_accounts.alphabetically,
          :id, :name,
          { prompt: t("scheduled_payments.form.select_target_account"),
            label: t("scheduled_payments.form.target_account_label"),
            variant: :logo } %>
    </div>

    <%= f.select :frequency,
        ScheduledPayment.frequencies.keys.map { |k| [t("scheduled_payments.form.frequencies.#{k}"), k] },
        { label: t("scheduled_payments.form.frequency_label") },
        { required: true } %>

    <%= f.number_field :frequency_day,
        label: t("scheduled_payments.form.frequency_day_label"),
        required: true,
        min: 0,
        max: 31,
        placeholder: "1" %>

    <%= f.date_field :start_date,
        label: t("scheduled_payments.form.start_date_label"),
        required: true %>

    <%= f.date_field :end_date,
        label: t("scheduled_payments.form.end_date_label") %>

    <div class="flex items-center justify-between gap-4 p-2">
      <div>
        <p class="text-sm font-medium text-primary"><%= t("scheduled_payments.form.auto_confirm_label") %></p>
        <p class="text-xs text-secondary"><%= t("scheduled_payments.form.auto_confirm_hint") %></p>
      </div>
      <%= f.toggle :auto_confirm %>
    </div>
  </section>

  <section>
    <%= f.submit t("scheduled_payments.form.save") %>
  </section>
<% end %>
