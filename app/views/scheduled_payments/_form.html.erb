<%= styled_form_with model: scheduled_payment,
    url: scheduled_payment.persisted? ? scheduled_payment_path(scheduled_payment) : scheduled_payments_path,
    class: "space-y-4",
    data: { controller: "scheduled-payment-form" } do |f| %>
  <% agenda_context_params.each do |name, value| %>
    <%= hidden_field_tag name, value %>
  <% end %>

  <% if scheduled_payment.errors.any? %>
    <%= render "shared/form_errors", model: scheduled_payment %>
  <% end %>

  <% if @from_entry_id.present? %>
    <%= f.hidden_field :from_entry_id, value: @from_entry_id %>
  <% end %>

  <%= render DS::Card.new(class: "space-y-4") do %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <%# Title %>
      <div>
        <%= f.text_field :title,
            label: t("scheduled_payments.form.title_label", default: "Title"),
            placeholder: t("scheduled_payments.form.title_placeholder", default: "e.g. Netflix, Rent, Salary..."),
            required: true %>
      </div>

      <%# Account %>
      <div>
        <%= f.collection_select :account_id,
            Current.family.accounts.writable_by(Current.user).navigation_visible.alphabetically,
            :id, :name,
            { prompt: t("scheduled_payments.form.select_account", default: "Select account"),
              label: t("scheduled_payments.form.account_label", default: "Account"),
              variant: :logo },
            { required: true } %>
      </div>

      <%# Amount %>
      <div>
        <%= f.number_field :amount,
            label: t("scheduled_payments.form.amount_label", default: "Amount"),
            required: true,
            min: 0,
            step: "0.01",
            placeholder: "10.00" %>
      </div>

      <%# Currency %>
      <div>
        <%= f.select :currency,
            currency_picker_options_for_family,
            { label: t("scheduled_payments.form.currency_label", default: "Currency") } %>
      </div>

      <%# Estimated amount toggle %>
      <div class="md:col-span-2">
        <div class="flex items-center justify-between gap-3 rounded-lg bg-container-inset p-3">
          <div>
            <p class="form-field__label"><%= t("scheduled_payments.form.amount_estimated_label") %></p>
            <p class="text-xs text-secondary"><%= t("scheduled_payments.form.amount_estimated_hint") %></p>
          </div>
          <%= f.toggle :amount_estimated, { data: { scheduled_payment_form_target: "amountEstimated",
                                                    action: "change->scheduled-payment-form#toggleEstimatedAmountFields" } } %>
        </div>
      </div>

      <%# Category %>
      <div>
        <%= f.collection_select :category_id,
            Current.family.categories.alphabetically_by_hierarchy,
            :id, :name,
            { prompt: t("scheduled_payments.form.select_category", default: "Select category (optional)"),
              label: t("scheduled_payments.form.category_label", default: "Category"),
              variant: :badge,
              searchable: true } %>
      </div>

      <%# Merchant %>
      <div>
        <%= f.collection_select :merchant_id,
            Current.family.available_merchants_for(Current.user).alphabetically,
            :id, :name,
            { include_blank: t("scheduled_payments.form.no_merchant", default: "None"),
              label: t("scheduled_payments.form.merchant_label", default: "Merchant"),
              variant: :logo,
              searchable: true } %>
      </div>

      <%# Tags %>
      <div>
        <%= render DS::TagSelect.new(
              form: f,
              tags: Current.family.tags.alphabetically,
              selected_ids: scheduled_payment.tag_ids,
              label: t("scheduled_payments.form.tags_label", default: "Tags")
            ) %>
      </div>

      <%# Payment type %>
      <div>
        <%= f.select :payment_type,
            ScheduledPayment.payment_types.keys.map { |k| [t("scheduled_payments.form.payment_types.#{k}", default: k.humanize), k] },
            { label: t("scheduled_payments.form.payment_type_label", default: "Payment type") },
            { data: { scheduled_payment_form_target: "paymentType",
                      action: "change->scheduled-payment-form#toggleTransferFields" } } %>
      </div>

      <%# Target account (only visible for transfers) %>
      <div data-scheduled-payment-form-target="transferFields"
           class="<%= 'hidden' unless scheduled_payment.transfer? %>">
        <%= f.collection_select :target_account_id,
            Current.family.accounts.writable_by(Current.user).navigation_visible.alphabetically,
            :id, :name,
            { prompt: t("scheduled_payments.form.select_target_account", default: "Select target account"),
              label: t("scheduled_payments.form.target_account_label", default: "Target account"),
              variant: :logo } %>
      </div>

      <%# Frequency %>
      <div>
        <%= f.select :frequency,
            ScheduledPayment.frequencies.keys.map { |k| [t("scheduled_payments.form.frequencies.#{k}", default: k.humanize), k] },
            { label: t("scheduled_payments.form.frequency_label", default: "Frequency") },
            { required: true, data: { scheduled_payment_form_target: "frequency",
                                     action: "change->scheduled-payment-form#toggleFrequencyFields" } } %>
      </div>

      <%# Start date %>
      <div>
        <%= f.date_field :start_date,
            label: t("scheduled_payments.form.start_date_label", default: "Start date"),
            required: true %>
      </div>

      <%# End date %>
      <div data-scheduled-payment-form-target="endDateFields" class="<%= 'hidden' if scheduled_payment.once? %>">
        <%= f.date_field :end_date,
            label: t("scheduled_payments.form.end_date_label", default: "End date (optional)") %>
      </div>

      <%# Auto confirm toggle %>
      <div data-scheduled-payment-form-target="autoConfirmFields" class="md:col-span-2 <%= 'hidden' if scheduled_payment.amount_estimated? %>">
        <div class="flex items-center justify-between gap-3 p-3 bg-container-inset rounded-lg">
          <div>
            <p class="form-field__label"><%= t("scheduled_payments.form.auto_confirm_label", default: "Auto confirm") %></p>
            <p class="text-xs text-secondary">
              <%= t("scheduled_payments.form.auto_confirm_hint", default: "Automatically create the transaction without manual confirmation") %>
            </p>
          </div>
          <%= f.toggle :auto_confirm %>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-end gap-2">
      <% if local_assigns[:modal] %>
        <%= render DS::Button.new(variant: "outline", text: t("shared.cancel"), icon: "x", type: "button", data: { action: "DS--dialog#close" }) %>
      <% else %>
        <%= render DS::Link.new(variant: "outline", href: agenda_back_path, text: t("shared.cancel"), icon: "x") %>
      <% end %>
      <%= f.submit t("scheduled_payments.form.save", default: "Save") %>
    </div>
  <% end %>
<% end %>
