<%= styled_form_with model: scheduled_payment, url: scheduled_payment.persisted? ? scheduled_payment_path(scheduled_payment) : scheduled_payments_path do |f| %>
  <div class="bg-container rounded-xl shadow-border-xs p-4 space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :title, class: "label" %>
        <%= f.text_field :title, class: "input" %>
      </div>

      <div>
        <%= f.label :account_id, class: "label" %>
        <%= f.collection_select :account_id, Current.user.accessible_accounts.alphabetically, :id, :name, {}, class: "input" %>
      </div>

      <div>
        <%= f.label :amount, class: "label" %>
        <%= f.number_field :amount, step: "0.01", class: "input" %>
      </div>

      <div>
        <%= f.label :currency, class: "label" %>
        <%= f.select :currency, currency_picker_options_for_family, {}, class: "input" %>
      </div>

      <div>
        <%= f.label :category_id, class: "label" %>
        <%= f.collection_select :category_id, Current.family.categories.alphabetically_by_hierarchy, :id, :name_with_parent, { include_blank: true }, class: "input" %>
      </div>

      <div>
        <%= f.label :merchant_id, class: "label" %>
        <%= f.collection_select :merchant_id, Current.family.available_merchants_for(Current.user).alphabetically, :id, :name, { include_blank: true }, class: "input" %>
      </div>

      <div>
        <%= f.label :payment_type, class: "label" %>
        <%= f.select :payment_type, ScheduledPayment.payment_types.keys, {}, class: "input" %>
      </div>

      <div>
        <%= f.label :target_account_id, class: "label" %>
        <%= f.collection_select :target_account_id, Current.user.accessible_accounts.alphabetically, :id, :name, { include_blank: true }, class: "input" %>
      </div>

      <div>
        <%= f.label :frequency, class: "label" %>
        <%= f.select :frequency, ScheduledPayment.frequencies.keys, {}, class: "input" %>
      </div>

      <div>
        <%= f.label :frequency_day, class: "label" %>
        <%= f.number_field :frequency_day, class: "input", min: 0, max: 31 %>
      </div>

      <div>
        <%= f.label :start_date, class: "label" %>
        <%= f.date_field :start_date, class: "input" %>
      </div>

      <div>
        <%= f.label :end_date, class: "label" %>
        <%= f.date_field :end_date, class: "input" %>
      </div>

      <div class="flex items-center gap-2">
        <%= f.check_box :auto_confirm, class: "checkbox" %>
        <%= f.label :auto_confirm, class: "label" %>
      </div>
    </div>

    <div class="flex items-center justify-end gap-2">
      <%= render DS::Link.new(variant: "outline", href: scheduled_payments_path, text: t("shared.cancel"), icon: "x") %>
      <%= render DS::Button.new(type: "submit", variant: "primary", text: t("shared.save")) %>
    </div>
  </div>
<% end %>
